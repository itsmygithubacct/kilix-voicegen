{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kilix:voicegen:schema:pronunciation-lexicon-entry:v1",
  "title": "Kilix Voicegen pronunciation lexicon JSONL entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "grapheme", "case", "roles", "syllables", "source"],
  "properties": {
    "schema": {"const": "kilix.voicegen.pronunciation-entry/v1"},
    "grapheme": {"type": "string", "minLength": 1, "maxLength": 256},
    "case": {"enum": ["exact", "ascii-fold"]},
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"}
    },
    "syllables": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stress", "segments"],
        "properties": {
          "stress": {"enum": ["none", "primary", "secondary"]},
          "segments": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,31}$"}
          }
        }
      }
    },
    "source": {"type": "string", "pattern": "^[a-z][a-z0-9._:/-]{0,127}$"}
  }
}
