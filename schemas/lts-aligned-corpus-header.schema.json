{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kilix:voicegen:schema:lts-aligned-corpus-header:v1",
  "title": "Kilix Voicegen aligned LTS training-corpus JSONL header",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "admission", "dialect", "source_lexicon_sha256", "alignment_record_sha256", "license_record_sha256", "review_record_sha256", "segment_inventory_sha256", "segment_inventory", "entry_count"],
  "properties": {
    "schema": {"const": "kilix.voicegen.lts-aligned-corpus/v1"},
    "admission": {"enum": ["product-admitted", "local-user", "test-fixture"]},
    "dialect": {"const": "en-AU"},
    "source_lexicon_sha256": {"$ref": "#/$defs/sha256"},
    "alignment_record_sha256": {"$ref": "#/$defs/sha256"},
    "license_record_sha256": {"$ref": "#/$defs/sha256"},
    "review_record_sha256": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/sha256"}
      ]
    },
    "segment_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "segment_inventory": {
      "type": "array",
      "minItems": 1,
      "maxItems": 65535,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": {"type": "integer", "minimum": 1, "maximum": 65535},
          "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,31}$"}
        }
      }
    },
    "entry_count": {"type": "integer", "minimum": 1, "maximum": 200000}
  },
  "allOf": [
    {
      "if": {"properties": {"admission": {"const": "product-admitted"}}},
      "then": {"properties": {"review_record_sha256": {"$ref": "#/$defs/sha256"}}},
      "else": {"properties": {"review_record_sha256": {"type": "null"}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
