{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kilix:voicegen:schema:heteronym-rule:v1",
  "title": "Kilix Voicegen contextual heteronym rule JSONL entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "rule_id", "target", "role", "capitalization", "position", "conditions", "source"],
  "properties": {
    "schema": {"const": "kilix.voicegen.heteronym-rule/v1"},
    "rule_id": {"type": "string", "pattern": "^[a-z][a-z0-9._:/-]{0,127}$"},
    "target": {"type": "string", "pattern": "^[a-z](?:[a-z]|['-](?=[a-z])){0,63}$"},
    "role": {"type": "string", "pattern": "^(?!default$)[a-z][a-z0-9-]{0,31}$"},
    "capitalization": {"enum": ["any", "lower", "title", "upper", "mixed"]},
    "position": {"enum": ["any", "clause-start", "clause-end", "single-word-clause"]},
    "conditions": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["offset", "words"],
        "properties": {
          "offset": {
            "type": "integer",
            "enum": [-3, -2, -1, 1, 2, 3]
          },
          "words": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z](?:[a-z]|['-](?=[a-z])){0,63}$"}
          }
        }
      }
    },
    "source": {"type": "string", "pattern": "^[a-z][a-z0-9._:/-]{0,127}$"}
  }
}
