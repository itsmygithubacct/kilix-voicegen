{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kilix:voicegen:schema:lts-aligned-entry:v1",
  "title": "Kilix Voicegen aligned LTS training entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "word", "emissions"],
  "properties": {
    "schema": {"const": "kilix.voicegen.lts-aligned-entry/v1"},
    "word": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[a-z](?:[a-z]|['-](?=[a-z]))*[a-z]$|^[a-z]$"},
    "emissions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "array",
        "maxItems": 4,
        "items": {"$ref": "#/$defs/emission"}
      }
    }
  },
  "$defs": {
    "emission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_ids", "syllable_end"],
      "properties": {
        "segment_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"type": "integer", "minimum": 1, "maximum": 65535}
        },
        "syllable_end": {
          "oneOf": [
            {"type": "null"},
            {"enum": ["none", "primary", "secondary"]}
          ]
        }
      }
    }
  }
}
