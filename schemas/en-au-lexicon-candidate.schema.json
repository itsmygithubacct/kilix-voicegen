{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kilix:voicegen:schema:en-au-lexicon-candidate:v1",
  "title": "One unreviewed CMUdict-to-General-Australian candidate entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "grapheme", "variant", "source_line", "source_phones", "candidate_segments", "stresses", "review_flags", "review_status"],
  "properties": {
    "schema": {"const": "kilix.voicegen.en-au-lexicon-candidate/v1"},
    "grapheme": {"type": "string", "minLength": 1, "pattern": "^\\S+$"},
    "variant": {"type": "integer", "minimum": 0},
    "source_line": {"type": "integer", "minimum": 1},
    "source_phones": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[A-Z]+[012]?$"}
    },
    "candidate_segments": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
    },
    "stresses": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer", "minimum": -1, "maximum": 2}
    },
    "review_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["AA_LOT_PALM_SPLIT_REVIEW", "AE_TRAP_BATH_SPLIT_REVIEW", "NO_PRONOUNCED_VOWEL_REVIEW", "POSTVOCALIC_R_DROPPED", "RHOTIC_VOWEL_TRANSFORMED"]
      }
    },
    "review_status": {"enum": ["machine-candidate-unreviewed", "needs-review"]}
  }
}
